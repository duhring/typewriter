# Homebrew dependencies for PKA. Install with: brew bundle
# Nothing here is required any more. bootstrap.sh fetches, into vendor/:
#   Python (uv), ffmpeg/ffprobe (pinned static build); yt-dlp is in requirements.txt;
#   Node for HyperFrames is fetched on first use by bin/pka npx (tools/node_runtime.py).
# git is optional: only the default clone install and git-based updates use it
# (macOS: xcode-select --install). Add your own brew lines here if you like.
