# Copy to discord-bridge/.env and fill in what you use. Everything is optional except
# where a tool says otherwise. Never commit .env.

# --- Discord bridge (tools/discord_send.py, discord-bridge/bot.py) ---
# Bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
# Channel the orchestrator posts to: right-click channel > Copy Channel ID
LARRY_CHANNEL_ID=
# Set to 1 only if the bot should bypass Claude Code permission prompts (unsafe default off)
# CLAUDE_DANGEROUS_SKIP_PERMISSIONS=1

# --- LLM routing (tools/llm.py). See docs/larry/llm-providers.md ---
# Default provider for tools that do not name one: lmstudio | glm | xai
LLM_PROVIDER=lmstudio
# Optional provider tried if the primary fails
LLM_FALLBACK=

# LM Studio (local OpenAI-compatible server; no key needed)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_CHAT_MODEL=
LM_STUDIO_EMBED_MODEL=
LM_STUDIO_TIMEOUT=120
LM_API_TOKEN=

# Zhipu / Z.AI GLM
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_CHAT_MODEL=glm-4.5
GLM_TIMEOUT=120

# xAI Grok
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_CHAT_MODEL=grok-4
XAI_REASON_MODEL=
XAI_TIMEOUT=120

# OpenAI (tools/generate_thumbnail.py uses the Images API)
OPENAI_API_KEY=

# --- Paths ---
# Where CueCam saves recordings (default ~/Movies/CueCam Presenter Recordings)
PKA_RECORDINGS_DIR=
# HyperFrames / motion project root (default <pka-root>/video-studio)
PKA_VIDEO_STUDIO=
# Where tools/backup_pka_db.py writes (default ~/PKA-backups)
PKA_BACKUP_DIR=

